# ===============================================
# ELDER DISCORD BOT - ENVIRONMENT VARIABLES
# ===============================================

# 1. Discord Bot Credentials (Required)
# From https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# 2. Server Testing Guild ID (Optional)
# Right click your Discord server > Copy Server ID for instant slash command sync
GUILD_ID=

# 3. Supabase Cloud Database (Recommended for Render)
# From Supabase Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Alternatively, direct PostgreSQL URI (Render Postgres, Neon, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# 4. Clan Moderation & Staff Configuration (Optional)
# Right click your staff role > Copy Role ID
STAFF_ROLE_ID=

# Channel ID where member DMs will be forwarded as Modmail tickets
MODMAIL_CHANNEL_ID=

# 5. Google Sheets Integration (Optional)
# Link to your clan roster spreadsheet
GOOGLE_SHEET_URL=
# Published CSV link (File > Share > Publish to web > CSV)
GOOGLE_SHEET_CSV_URL=

# 6. Web Server Port (Render sets this automatically to 10000 in production)
PORT=3000
