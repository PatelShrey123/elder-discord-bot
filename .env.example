# Discord Bot Secrets
# Obtain these from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Optional: Server/Guild ID for instant slash command updates during development
# Leave empty or omit to deploy commands globally
GUILD_ID=

# Render Port (Set automatically by Render in production, default 3000 for local)
PORT=3000
